{
  "manifest_version": 2,
  "name": "Preyt – YouTube Summaries",
  "short_name": "Preyt",
  "version": "0.2.0",
  "description": "Right-click a YouTube link or video page for a short summary and timestamped key points, generated by Google Gemini with your own API key.",
  "icons": { "48": "icons/preyt.svg", "96": "icons/preyt.svg" },
  "browser_specific_settings": {
    "gecko": {
      "id": "preyt-yt-summary@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  },
  "permissions": [
    "menus",
    "storage",
    "https://www.youtube.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "page": "background/background.html",
    "persistent": true
  },
  "browser_action": {
    "default_title": "Preyt – YouTube summary",
    "default_icon": "icons/preyt.svg",
    "default_popup": "popup/summary.html",
    "default_area": "navbar"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": false
  },
  "content_security_policy": "script-src 'self'; object-src 'none'; base-uri 'none'"
}
